# Copy to .env and fill in. Read automatically by leadfinder on startup.

# ---------------------------------------------------------------- Qwen / LLM
# Any OpenAI-compatible /chat/completions endpoint. Examples:
#   vLLM        http://192.168.1.50:8000/v1
#   llama.cpp   http://192.168.1.50:8080/v1
#   LM Studio   http://192.168.1.50:1234/v1
#   Ollama      http://192.168.1.50:11434/v1
LEADFINDER_QWEN_BASE_URL=
LEADFINDER_QWEN_MODEL=
LEADFINDER_QWEN_API_KEY=
# openai_compatible | ollama | llamacpp
LEADFINDER_QWEN_PROVIDER=openai_compatible

# ---------------------------------------------------------------- Search
# Primary provider: brave (free tier, ~1 QPS). Get a key at
# https://api-dashboard.search.brave.com/ and paste it below.
LEADFINDER_SEARCH_PROVIDER=brave
LEADFINDER_BRAVE_API_KEY=
# Safety cap so a 98-row benchmark cannot silently drain the monthly quota.
LEADFINDER_BRAVE_MAX_QUERIES=400
# Free scrapers used when Brave is missing, capped or rate-limited.
LEADFINDER_SEARCH_FALLBACK_PROVIDERS=duckduckgo,bing

# Optional: self-hosted SearXNG (docker compose in docker/). Used when
# LEADFINDER_SEARCH_PROVIDER=searxng. SearXNG only answers with JSON when
# "json" is in search.formats (already set in docker/searxng/settings.yml).
LEADFINDER_SEARCH_BASE_URL=http://localhost:8888
LEADFINDER_SEARCH_FORMAT=json

# ---------------------------------------------------------------- Budgets
# Per-company ceilings. Defaults shown; override for longer or cheaper runs.
# LEADFINDER_MAX_SEARCH_QUERIES=20
# LEADFINDER_MAX_PAGES=30
# LEADFINDER_MAX_LLM_ROUNDS=4
# LEADFINDER_WORKERS=4
